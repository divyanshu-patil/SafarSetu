PORT=4000
# Leave SUPABASE_* empty to use the in-memory store (demo works with zero setup).
# Local Supabase: run `npx supabase start` in apps/api and copy values from `npx supabase status`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SIM_ENABLED=true
# Optional: require this header value (x-ingest-key) on POST /v1/disruptions
INGEST_KEY=
# Contact sent in User-Agent to Nominatim/Photon (usage policy)
GEO_CONTACT=safarsetu-demo@example.com

# Authority portal (demo accounts live in src/demo-users.ts; production: Supabase Auth / agency SSO)
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_DEMO_HINT=true
# Seed ~55 synthetic demo reports on boot (set false in production)
SEED_DEMO=true
