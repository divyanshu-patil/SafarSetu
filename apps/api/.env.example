PORT=4000
# Leave SUPABASE_* empty to use the in-memory store (demo works with zero setup).
# Local Supabase: run `npx supabase start` in apps/api and copy values from `npx supabase status`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SIM_ENABLED=true
# Optional: require this header value (x-ingest-key) on POST /v1/disruptions
INGEST_KEY=
# Contact sent in User-Agent to Nominatim/Photon (usage policy)
GEO_CONTACT=safarsetu-demo@example.com

# Authority portal (demo accounts live in src/demo-users.ts; production: Supabase Auth / agency SSO)
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_DEMO_HINT=true
# Seed ~55 synthetic demo reports on boot (set false in production)
SEED_DEMO=true

# Team key for logging field interviews (POST /v1/field/interviews). Required in production; unset = open in dev.
FIELD_KEY=

# Reports older than this are deleted daily (privacy notice says 12 months)
REPORT_RETENTION_DAYS=365

# Optional live feed (no public feed exists yet — see docs/16). pmpml|best and pune|mumbai
GTFS_RT_URL=
GTFS_RT_PREFIX=pmpml
GTFS_RT_CITY=pune
