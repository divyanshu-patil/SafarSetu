{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "seed:sql": "tsx scripts/seed-sql.ts > supabase/seed.sql",
    "test:supabase": "tsx scripts/supabase-smoke.mts"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@supabase/supabase-js": "^2.58.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "gtfs-realtime-bindings": "^1.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "26.4.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  }
}
